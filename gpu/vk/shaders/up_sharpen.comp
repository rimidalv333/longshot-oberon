#version 450
// (2026-11-23, after ProjectReLink 0.7.9.3's dlss_out.comp) The upscaler's picture (FSR 3.1's, DLSS's, on the temporal chain:
// vk_temporal.cpp) into OoT's gameplay upscale's output, as dlss_out.comp writes it (the square of its perceptual encoding:
// linear colour again), sharpened first: the 3D alone, before the game draws its HUD over it, at its own size, in the
// perceptual encoding (as the eye weighs it). The pixel is pushed away from the mean of its four neighbours and held near the
// darkest and the lightest of the five: it may pass them by pc.over of their distance, no more. The overshoot is a share of
// the local contrast, so flat parts (sky, noise) get next to none and an edge's halo is as small as the edge is soft.
// pc.sharp 0: dlss_out.comp's picture exactly. The window's Sharpness pass leaves the 3D alone meanwhile (vk_framegen.cpp)
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; float sharp; float over; } pc;
layout(constant_id = 0) const bool kSquare = true;   // (as dlss_out.comp: the square-root encoded picture made linear)
vec3 tap(ivec2 g, bool same) {
    const ivec2 q = clamp(g, ivec2(0), pc.size - 1);
    const vec3 c = same ? texelFetch(src, q, 0).rgb : textureLod(src, (vec2(q) + 0.5) / vec2(pc.size), 0.0).rgb;
    return max(c, vec3(0.0));
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    const bool same = all(equal(textureSize(src, 0), pc.size));
    vec3 c = tap(g, same);
    if (pc.sharp > 0.0) {
        const vec3 n = tap(g + ivec2(0, -1), same), s = tap(g + ivec2(0, 1), same);
        const vec3 w = tap(g + ivec2(-1, 0), same), e = tap(g + ivec2(1, 0), same);
        const vec3 lo = min(min(min(n, s), min(w, e)), c), hi = max(max(max(n, s), max(w, e)), c);
        const vec3 room = (hi - lo) * pc.over;
        c = clamp(c + pc.sharp * (c - (n + s + w + e) * 0.25), max(lo - room, vec3(0.0)), min(hi + room, vec3(1.0)));
    }
    if (kSquare) c *= c;
    imageStore(dst, g, vec4(c, 1.0));
}
